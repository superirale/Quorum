{
  "name": "@quorum/claude-agent",
  "version": "0.1.0",
  "description": "Quorum: a language model reading a workspace — deterministic context packing, trust-fenced prompts, and published memory",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "predemo": "pnpm --filter @quorum/sdk --filter @quorum/test-kit build",
    "demo": "node --experimental-strip-types src/demo.ts",
    "prelive": "pnpm --filter @quorum/sdk build",
    "live": "node --experimental-strip-types src/live.ts",
    "prestart": "pnpm --filter @quorum/sdk build",
    "start": "node --experimental-strip-types src/main.ts",
    "pretypecheck": "pnpm --filter @quorum/sdk --filter @quorum/test-kit build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@quorum/protocol": "workspace:*",
    "@quorum/sdk": "workspace:*"
  },
  "devDependencies": {
    "@quorum/test-kit": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
