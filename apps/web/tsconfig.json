{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `bundler` rather than `nodenext`: Vite resolves imports, not Node. The
    // rest of the repo can keep Node's rules because everything else in it runs
    // under Node.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
