{
  "$id": "https://quorum.chat/schemas/body-38101-thread-state.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "open",
        "working",
        "blocked",
        "paused",
        "done"
      ]
    },
    "title": {
      "type": "string"
    },
    "assignee": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "lowercase hex secp256k1 x-only public key"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "msat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "spent": {
      "type": "object",
      "properties": {
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "msat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "folded_from": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "seconds since the unix epoch"
    }
  },
  "required": [
    "status"
  ],
  "title": "ThreadState body (kind 38101)"
}
