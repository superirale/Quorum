{
  "$id": "https://quorum.chat/schemas/body-38107-channel-policy.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enc": {
      "type": "string",
      "enum": [
        "plaintext",
        "nip44",
        "mls"
      ],
      "description": "plaintext | nip44 | mls"
    },
    "epoch": {
      "description": "required when enc is not plaintext",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "description": "e.g. \"rotated after removing 2ebfa99b…\"",
      "type": "string"
    },
    "changed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "seconds since the unix epoch"
    }
  },
  "required": [
    "enc"
  ],
  "title": "ChannelPolicy body (kind 38107)"
}
