{
  "$id": "https://quorum.chat/schemas/body-8109-thread-op.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set_status"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "working",
            "blocked",
            "paused",
            "done"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "assign"
        },
        "assignee": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "lowercase hex secp256k1 x-only public key"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "op",
        "assignee"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set_title"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "op",
        "title"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "set_budget"
        },
        "budget": {
          "type": "object",
          "properties": {
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "msat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "op",
        "budget"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "add_spend"
        },
        "cost": {
          "type": "object",
          "properties": {
            "tokens_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokens_out": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usd": {
              "type": "number",
              "minimum": 0
            },
            "msat": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "cost"
      ]
    }
  ],
  "title": "ThreadOp body (kind 8109)"
}
