{
  "$id": "https://quorum.chat/schemas/body-8112-mls-commit.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "MLS group epoch; the first one is 0"
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "description": "base64 framed MLSMessage"
    },
    "adds": {
      "default": [],
      "description": "pubkeys this commit adds, as claimed",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "lowercase hex secp256k1 x-only public key"
      }
    }
  },
  "required": [
    "epoch",
    "commit"
  ],
  "title": "MlsCommit body (kind 8112)"
}
