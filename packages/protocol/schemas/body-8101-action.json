{
  "$id": "https://quorum.chat/schemas/body-8101-action.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "stable dotted identifier, e.g. \"deploy.production\""
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "awaiting_approval",
        "running",
        "succeeded",
        "failed",
        "denied",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "what this action does, in human words"
    },
    "input": {},
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the canonical JSON encoding"
    },
    "output": {},
    "output_summary": {
      "description": "what happened, in human words",
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "stable machine-readable code, e.g. \"permission_denied\""
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "cost": {
      "description": "present on terminal events when known",
      "type": "object",
      "properties": {
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "msat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "on_behalf_of": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "status",
    "summary"
  ],
  "title": "Action body (kind 8101)"
}
