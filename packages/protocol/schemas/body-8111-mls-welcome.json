{
  "$id": "https://quorum.chat/schemas/body-8111-mls-welcome.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "MLS group epoch; the first one is 0"
    },
    "invite": {
      "type": "string",
      "minLength": 132,
      "description": "base64 NIP-44 payload wrapping the Welcome"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "lowercase hex secp256k1 x-only public key"
    },
    "key_package": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "lowercase hex event id"
    }
  },
  "required": [
    "epoch",
    "invite",
    "recipient",
    "key_package"
  ],
  "title": "MlsWelcome body (kind 8111)"
}
