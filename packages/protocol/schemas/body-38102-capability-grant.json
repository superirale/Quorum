{
  "$id": "https://quorum.chat/schemas/body-38102-capability-grant.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "grantee": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "the agent principal receiving this capability"
    },
    "grant": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. \"action:deploy.production\""
        },
        "actions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "e.g. [\"invoke\"]"
        },
        "scope": {
          "description": "narrowing constraints, e.g. {\"env\": \"production\"}",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "seconds since the unix epoch"
        },
        "max_uses": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "resource",
        "actions"
      ]
    },
    "via": {
      "description": "addressable coordinate 38106:<pubkey>:<d>",
      "type": "string"
    },
    "revoked": {
      "default": false,
      "type": "boolean"
    },
    "revoked_reason": {
      "type": "string"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "seconds since the unix epoch"
    }
  },
  "required": [
    "grantee",
    "grant"
  ],
  "title": "CapabilityGrant body (kind 38102)"
}
